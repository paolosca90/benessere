FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp
WORKDIR /app
RUN pip install --no-cache-dir "streamlit>=1.39,<2" "pandas>=2.2,<3" "requests>=2.31,<3" "mcp>=1.0,<2" \
    && pip check
COPY app.py mcp_remote.py mcp_server.py sheets_bridge.py /app/
COPY benessere /app/benessere/
USER 10001:10001
